{
  "name": "employers-checking-service",
  "version": "1.0.0",
  "description": "A service for employers to check employee's immigration status",
  "main": "index.js",
  "engines": {
    "node": ">=24.18.0 <25.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "start:dev": "hof-build watch --env",
    "build": "hof-build",
    "postinstall": "hof-build",
    "test:lint": "eslint . --config ./node_modules/eslint-config-hof/default.js",
    "test:unit": "LOG_LEVEL=error nyc _mocha \"test/_unit/**/*.spec.js\"",
    "bddgen": "bddgen",
    "test:e2e": "bddgen && playwright test",
    "test:e2e:headed": "bddgen && playwright test --headed",
    "test:e2e:debug": "bddgen && playwright test --debug",
    "test:e2e:report": "playwright show-report"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UKHomeOffice/ecs.git"
  },
  "author": "HOF",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/UKHomeOffice/ecs/issues"
  },
  "homepage": "https://github.com/UKHomeOffice/ecs#readme",
  "dependencies": {
    "accessible-autocomplete": "^3.0.1",
    "hof": "~24.4.0",
    "notifications-node-client": "^8.4.0"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^13.2.0",
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.1",
    "chai": "^6.2.2",
    "dotenv": "^17.4.2",
    "eslint": "^8.57.0",
    "eslint-config-hof": "^1.3.4",
    "mocha": "^11.7.6",
    "nyc": "^18.0.0",
    "playwright-bdd": "^9.2.0"
  },
  "mocha": {
    "reporter": "spec",
    "require": "test/setup.js",
    "recursive": "true",
    "timeout": "6000"
  }
}
